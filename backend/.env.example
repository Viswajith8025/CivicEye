# Civic Eye Backend
# Local MongoDB (no auth):
# DB_URL=mongodb://127.0.0.1:27017/civiceye
# Or use in-memory DB for quick local demo (no Docker/Atlas required):
USE_MEMORY_DB=true
SEED_DEMO_USERS=true
# Atlas example (encode special chars in password, allow your IP in Atlas Network Access):
# DB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/civiceye?retryWrites=true&w=majority
KEY=replace_with_at_least_32_random_characters
SALT=10
PORT=5001
FRONTEND_URL=http://localhost:5173
# Comma-separated extra CORS origins (production frontend URL is auto-added from FRONTEND_URL)
ALLOWED_ORIGINS=
NODE_ENV=development
LOG_LEVEL=info

# Email (optional — in-app notifications work without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CivicEye <noreply@civiceye.app>

# OpenAI (optional — rule-based summaries used when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# S3 storage (optional — uses local disk when unset)
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
